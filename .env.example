# Copy this file to `.env.local` and fill in real keys (never commit .env.local).
# The app boots fine without keys; it replies with a clean "not configured"
# error until the primary provider's key is set. See README.md.

# Which provider answers first: openrouter (default) or gemini. The other one is
# used automatically when the first is unavailable (limit, quota, outage).
AI_PRIMARY_PROVIDER=

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_MODEL defaults to nvidia/nemotron-3-super-120b-a12b:free when empty;
# free models change over time — see https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini API (https://aistudio.google.com/apikey)
# GEMINI_MODEL defaults to gemini-3.5-flash when empty; see
# https://ai.google.dev/gemini-api/docs/models for current model codes.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: Gemini models tried next when GEMINI_MODEL is out of quota or overloaded
# (free-tier quota is per model). Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=

# --- Engineering Knowledge / RAG (all optional) ---------------------------
# Local embedding model (runs on CPU via ONNX; downloaded once to .cache/models).
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Where the vector index and uploaded documents are stored (default: ./data).
# IFLCHAT_DATA_DIR=
# Retrieval relevance thresholds (cosine similarity, bge-small scale).
# RAG_STRONG_SIMILARITY=0.62
# RAG_WEAK_SIMILARITY=0.56
